                   </div>\n                </div>\n                <div class=\"px-6 py-4\">\n                    <div class=\"flex justify-between items-center\">\n                        <div>\n                            <h3 class=\"text-sm font-medium text-gray-900\">Français</h3>\n                            <p class=\"mt-1 text-sm text-gray-500\">Fr</p>\n                        </div>\n                        <a href=\"/subjects/16080\" class=\"px-3 py-1 bg-blue-100 text-blue-700 text-sm rounded-md hover:bg-blue-200\">\n                            Voir\n                        </a>\n                    </div>\n                </div>\n                <div class=\"px-6 py-4\">\n                    <div class=\"flex justify-between items-center\">\n                        <div>\n                            <h3 class=\"text-sm font-medium text-gray-900\">Mathematiques</h3>\n                            <p class=\"mt-1 text-sm text-gray-500\">Maths</p>\n                        </div>\n                        <a href=\"/subjects/16076\" class=\"px-3 py-1 bg-blue-100 text-blue-700 text-sm rounded-md hover:bg-blue-200\">\n                            Voir\n                        </a>\n                    </div>\n                </div>\n                <div class=\"px-6 py-4\">\n                    <div class=\"flex justify-between items-center\">\n                        <div>\n                            <h3 class=\"text-sm font-medium text-gray-900\">Physiques</h3>\n                            <p class=\"mt-1 text-sm text-gray-500\">Phy</p>\n                        </div>\n                        <a href=\"/subjects/16089\" class=\"px-3 py-1 bg-blue-100 text-blue-700 text-sm rounded-md hover:bg-blue-200\">\n                            Voir\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n    </main>\n\n    <!-- Footer -->\n    <div class=\"footer py-8 border-t border-gray-300 pb-24\">\n